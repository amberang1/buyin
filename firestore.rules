rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidExchangeRate(rate) {
      return rate is map &&
             rate.keys().hasAll(['baseCurrency', 'chips']) &&
             rate.baseCurrency is number && rate.baseCurrency > 0 &&
             rate.chips is number && rate.chips > 0;
    }

    function isValidGame(data) {
      return hasRequiredFields(['status', 'exchangeRate', 'createdAt', 'hostId']) &&
             hasOnlyAllowedFields(['status', 'exchangeRate', 'createdAt', 'hostId']) &&
             data.status in ['setup', 'active', 'settlement', 'results'] &&
             isValidExchangeRate(data.exchangeRate) &&
             data.createdAt is string &&
             data.hostId is string && data.hostId.size() > 0 && data.hostId.size() < 100;
    }

    function isValidPlayer(data) {
      return hasRequiredFields(['name', 'buyIns', 'cashOuts', 'finalStackValue']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             data.buyIns is list && data.buyIns.size() <= 100 &&
             data.cashOuts is list && data.cashOuts.size() <= 100 &&
             data.finalStackValue is number && data.finalStackValue >= 0 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 1048576)) && // 1MB limit for base64 photo
             (!('userId' in data) || (data.userId is string && data.userId.size() < 100));
    }

    match /games/{gameId} {
      // Anyone can read games (to join them)
      allow read: if true;
      
      // Anyone can create a game
      allow create: if isValidGame(request.resource.data);
      
      // Anyone can update a game (e.g. changing status)
      // We ensure hostId doesn't change.
      allow update: if isValidGame(request.resource.data) &&
                    request.resource.data.hostId == resource.data.hostId;
      
      match /players/{playerId} {
        // Anyone can read players in a game
        allow read: if true;
        
        // Anyone can add a player
        allow create: if isValidPlayer(request.resource.data);
        
        // Anyone can update a player (e.g. adding buy-ins)
        allow update: if isValidPlayer(request.resource.data);
        
        // Anyone can delete a player
        allow delete: if true;
      }
    }
  }
}
